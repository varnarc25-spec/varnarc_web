# =============================================================================
# Varnarc VPS production environment (EXAMPLE ONLY — copy to .env.production)
# NEVER commit .env.production. Fill secrets on the VPS only.
#
# Copy:
#   cp .env.production.example .env.production
#
# Used by:
#   docker compose -f docker/docker-compose.vps.yml --env-file .env.production up -d
# =============================================================================

NODE_ENV=production
APP_ENV=production
APP_VERSION=production

# -----------------------------------------------------------------------------
# Public URLs (safe to expose to the browser / baked into Next.js client bundles)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://varnarc.com
NEXT_PUBLIC_ADMIN_URL=https://admin.varnarc.com
# Browser-facing API. Absolute URL is required so admin.varnarc.com can call
# the same API origin. Relative /api/v1 only works for requests on varnarc.com.
NEXT_PUBLIC_API_URL=https://varnarc.com/api/v1
NEXT_PUBLIC_AUTH0_CONFIGURED=false
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_DEFAULT=
NEXT_PUBLIC_ADSENSE_SLOT_CALCULATOR_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_CALCULATOR_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_SIDEBAR=
NEXT_PUBLIC_CMP_DOMAIN_KEY=
NEXT_PUBLIC_CMP_ENV=production
NEXT_PUBLIC_CMP_SDK_URL=
NEXT_PUBLIC_CMP_TEST_SCRIPTS=false
NEXT_PUBLIC_CONTACT_EMAIL=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# Server-only app URLs (Next.js server / Nest CORS — not NEXT_PUBLIC_*)
# API_URL must be reachable FROM the web/admin containers (Docker DNS).
# Do not set API_URL=/api/v1 — server-side fetch cannot use a relative path.
# -----------------------------------------------------------------------------
APP_BASE_URL=https://varnarc.com
WEB_APP_URL=https://varnarc.com
ADMIN_APP_URL=https://admin.varnarc.com
PUBLIC_APP_URL=https://varnarc.com
API_URL=http://api:4000/api/v1
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
PORT=4000

# -----------------------------------------------------------------------------
# Database (VPS PostgreSQL — not public). Leave Neon URL here until cutover.
# After cutover, use the docker-internal host "postgres" (never expose 5432).
# Special characters in POSTGRES_PASSWORD must be URL-encoded in DATABASE_URL.
# -----------------------------------------------------------------------------
POSTGRES_USER=varnarc
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=varnarc
# During first VPS deploy you may keep Neon, e.g.:
# DATABASE_URL=postgresql://USER:PASS@HOST/varnarc_db?sslmode=require
# After migrating data to the VPS container:
DATABASE_URL=postgresql://varnarc:change-me-strong-password@postgres:5432/varnarc
DATABASE_DIRECT_URL=postgresql://varnarc:change-me-strong-password@postgres:5432/varnarc

# -----------------------------------------------------------------------------
# Redis (internal Docker network)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
RATE_LIMIT_PER_MINUTE=120

# -----------------------------------------------------------------------------
# Search — production code defaults to OpenSearch if SEARCH_ENGINE is unset.
# Set postgres-fts on the VPS unless you also run OpenSearch.
# -----------------------------------------------------------------------------
SEARCH_ENGINE=postgres-fts
OPENSEARCH_URL=
OPENSEARCH_INDEX=varnarc-search
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# -----------------------------------------------------------------------------
# Auth0 (public site login) — server-only secrets. Never prefix with NEXT_PUBLIC_
# except NEXT_PUBLIC_AUTH0_CLIENT_ID / NEXT_PUBLIC_AUTH0_CONFIGURED.
# Callbacks: https://varnarc.com/auth/callback
# Logout:    https://varnarc.com
# -----------------------------------------------------------------------------
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=
AUTH0_ISSUER_BASE_URL=
AUTH0_CONNECTION=Username-Password-Authentication
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Admin portal (email/password in app DB — not Auth0)
# -----------------------------------------------------------------------------
ADMIN_JWT_SECRET=change-me-long-random-string
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-bootstrap-password
BOOTSTRAP_ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# API / email / AI / media (server-only)
# -----------------------------------------------------------------------------
EMAIL_FROM=noreply@varnarc.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

OPENAI_API_KEY=
AI_DEFAULT_MODEL=gemini-flash-latest
AI_BASE_URL=
AI_IMAGE_MODEL=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
PRIMARY_AI_KEY=
BACKUP_AI_KEY=
AI_DAILY_JOB_LIMIT=
PEXELS_API_KEY=
CALCULATOR_API_ALLOWLIST=

GCS_BUCKET=
GCS_PROJECT_ID=
GCS_PUBLIC_BASE_URL=
GCS_MAKE_PUBLIC=false
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

ADSENSE_SYNC_ENABLED=false
ADSENSE_SYNC_INTERVAL_MS=
ADSENSE_OAUTH_CLIENT_ID=
ADSENSE_OAUTH_CLIENT_SECRET=
ADSENSE_OAUTH_REFRESH_TOKEN=
ADSENSE_ACCOUNT_ID=
ADSENSE_CURRENCY=INR

CACHE_PUBSUB_TOPIC=
CACHE_PUBSUB_SUBSCRIPTION=
CACHE_INVALIDATION_SUBSCRIBE=false

PROMETHEUS_ENABLED=false
PROMETHEUS_SCRAPE_TOKEN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=varnarc-api

CATALOG_IMPORT_BATCH_SIZE=500
CATALOG_IMPORT_MAX_MB=50
